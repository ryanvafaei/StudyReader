{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "sonnet",
  "permissions": {
    "allow": [
      "Bash(./scripts/check-fresh-clone.sh *)",
      "Bash(./scripts/check-fresh-clone.sh)",
      "Bash(./scripts/test.sh *)",
      "Bash(./scripts/test.sh)",
      "Bash(./scripts/build.sh *)",
      "Bash(./scripts/build.sh)",
      "Bash(xcodegen *)",
      "Bash(xcodebuild *)",
      "Bash(xcrun *)",
      "Bash(swift build *)",
      "Bash(swift test *)",
      "Bash(swift package *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git switch *)",
      "Bash(git branch *)",
      "Bash(ls *)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(wc *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(./scripts/uitest.sh)",
      "Bash(./scripts/uitest.sh *)",
      "Bash(./scripts/run-app.sh)",
      "Bash(./scripts/run-app.sh *)",
      "Bash(./scripts/lsregister-clean.sh)",
      "Bash(./scripts/lsregister-clean.sh *)",
      "mcp__peekaboo",
      "Bash(./scripts/ci.sh)",
      "Bash(./scripts/ci.sh *)",
      "Bash(git push)",
      "Bash(git push origin master)",
      "Bash(git fetch *)",
      "Bash(git pull --rebase origin master)"
    ],
    "deny": [
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(rm -rf *)",
      "Read(./Secrets/**)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Edit(./scripts/**)",
      "Write(./scripts/**)",
      "Edit(./.claude/settings.json)",
      "Write(./.claude/settings.json)",
      "Edit(./Secrets/**)",
      "Write(./Secrets/**)",
      "mcp__peekaboo__analyze",
      "mcp__peekaboo__clipboard",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git push origin +*)",
      "Bash(git push origin --delete *)",
      "Edit(./.github/**)",
      "Write(./.github/**)"
    ]
  },
  "env": {
    "CLAUDE_CODE_FORK_SUBAGENT": "0",
    "BASH_DEFAULT_TIMEOUT_MS": "2400000",
    "BASH_MAX_TIMEOUT_MS": "4200000"
  },
  "sandbox": {
    "excludedCommands": [
      "./scripts/build.sh",
      "./scripts/build.sh *",
      "./scripts/test.sh",
      "./scripts/test.sh *",
      "./scripts/check-fresh-clone.sh",
      "./scripts/uitest.sh",
      "./scripts/uitest.sh *",
      "./scripts/run-app.sh",
      "./scripts/run-app.sh *",
      "./scripts/lsregister-clean.sh",
      "./scripts/lsregister-clean.sh *",
      "./scripts/ci.sh",
      "./scripts/ci.sh *"
    ],
    "filesystem": {
      "denyRead": [
        "/Users/ali/Documents/Projects/StudyReader/Secrets"
      ]
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/session-start.sh",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
